  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__(?:(?!__).)*[Ee][Pp][Ii][Pp][Hh][Aa][Nn](?:(?!__).)*__",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/epiphan-write-guard.sh\""
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-secrets.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(?:(?!__).)*[Ee][Pp][Ii][Pp][Hh][Aa][Nn](?:(?!__).)*__",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/epiphan-redact.sh\""
          }
        ]
      }
    ]
