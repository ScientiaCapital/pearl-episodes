# Copy to .env and fill in. Never commit .env (it is gitignored, and check-secrets.sh and gitleaks look for it).
# Pearl device REST API (one device; the fleet comes from Epiphan Edge via MCP)
PEARL_HOST=192.168.1.50
PEARL_USERNAME=admin
PEARL_PASSWORD=
# Base path verified against Epiphan's OpenAPI spec (v2.0), 2026-10-14. HTTP Basic auth over HTTPS.
PEARL_API_PREFIX=/api/v2.0
# TLS is verified by default. A bench Pearl with its own self-signed certificate needs false here, set on purpose.
PEARL_VERIFY_TLS=true
# Where pulled recordings and packaged episodes land (gitignored)
PEARL_EPISODES_RECORDINGS_DIR=./recordings
PEARL_EPISODES_OUTPUT_DIR=./episodes
