# Copy to .env and fill in. Never commit .env.
# Pearl device REST API (one device; the fleet comes from Epiphan Edge via MCP)
PEARL_HOST=10.2.5.161
PEARL_USERNAME=admin
PEARL_PASSWORD=
# Verify the API prefix against kb.epiphan.com (pearl-family/pearl-rest-api-*) before relying on it
PEARL_API_PREFIX=/api/v2.0
PEARL_VERIFY_TLS=false
# Where pulled recordings and packaged episodes land (gitignored)
PEARL_EPISODES_RECORDINGS_DIR=./recordings
PEARL_EPISODES_OUTPUT_DIR=./episodes
